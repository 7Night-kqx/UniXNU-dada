# Kernel configuration of the dada image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
#
# The first-boot goal is the video console and the genuine missing-driver panic, so this list starts
# from the sheng reference and drops every module that is board specific to SM8550 or not yet written
# for SM8750 (Adreno 830, ShenG PMGR, the owner/root paths).

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# The storage transport is on, with its block-device half.
#
# The NativeUfs in this tree is the sheng (SM8550) driver. What SM8750 needs of it is done: the
# compatible match covers "qcom,ufshc" (the stock dada tree) as well as the SoC-qualified names, and
# the nine GCC clock offsets are the SM8750 ones (docs/ufs-sm8750.md has the table and its source),
# and reading a full GPT through the adopted controller works (native-ufs-probe=9).
#
# The block-device half derives from IOBlockStorageDevice, which is not in the xnu tree but is a
# class of Apple's separate IOStorageFamily project -- and the kernelcache already carries
# com.apple.iokit.IOStorageFamily. Compiling that base class in would register a second class of the
# same name and OSMetaClass would panic:
#   "OSMetaClass: Kext com.apple.iokit.IOStorageFamily class IOBlockStorageDevice is a duplicate;
#    kext __kernel__ already has a class by that name." (libkern/c++/OSMetaClass.cpp:894)
# The prelinked kext cannot be dropped instead: com.apple.driver.AppleARMPlatform and
# com.apple.filesystems.apfs both depend on it, so the prelink closure pulls it back in.
#
# So the transport keeps its block-device half and the base class is NOT compiled in. The archives of
# board.toml [kernel] build the pinned IOBlockStorageDevice reference object (for its 190-slot
# dispatch shape) and then run scripts/build-storage-kext-bindings.py, which rebinds the transport's
# IOBlockStorageDevice imports to the addresses the prelinked kext itself uses. Exactly one class of
# that name exists at run time, so OSMetaClass has nothing to refuse.
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_UFS_PROBE_ONLY=n
CONFIG_XNU_NATIVE_AES=y
# The trust cache runtime is off. The port patch native-trust-cache-runtime.patch compiles
# trust_cache_runtime_init() into the boot only when XNU_NATIVE_TRUST_CACHE is 1, and that function
# panics with "amfi interface not available" (bsd/kern/kern_trustcache.c) when no AMFI has published
# its interface. This board prelinks no AMFI (see board.toml [kernel.prelink] roots: the AMFI path is
# the owner-root path, which needs storage first), so the runtime is left out; the static trust cache
# is not loaded either, which is no loss: the ADT carries an empty TrustCache node anyway.
CONFIG_XNU_TRUST_CACHE_RUNTIME=n
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
# Boot progress is off for the first boot. scripts/build-xnu-4k-baseline.sh refuses it unless the
# audited UFS/owner-root, Virtio block and source-corecrypto build are all selected together; those
# are the owner-root path this port does not have yet. The kernel prints through the video console and
# the serial console without it. Turn it back on (with the whole audited set) once that path exists.
CONFIG_XNU_BOOT_PROGRESS=n

# The panic log region comes from the device tree, not from a hardcoded address. With this off,
# pexpert's check_for_panic_log() falls back to PLATFORM_PANIC_LOG_PADDR (0x3c0fc000), which is the
# QEMU/Raspberry Pi address of the BCM2837 platform file. On this board that address is a hole in
# DRAM, so the kernel would map it and then clear 16 KiB there before the console exists: the write
# aborts and the boot hangs with no output. With this on, the region is looked up in the DT; the
# board has no panic region yet, so the lookup fails and the whole path is skipped (what the sheng
# reference port does too).
CONFIG_XNU_DT_PANIC_REGION=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

# Explicitly off for the first boot:
#   XNU_NATIVE_ADRENO          there is no Adreno 830 driver; the GPU is a later project
#   XNU_SHENG_PMGR             the sheng PMGR integration is SM8550 board code
#   XNU_NATIVE_MOBILE_DISPLAY  needs the Adreno path
#   XNU_ARMVIRT_PLATFORM       this is not the QEMU virt platform
#   XNU_SOURCE_MOCKFS          test fixture, not wanted in a device kernel
#   XNU_NATIVE_LEGACY_DISPLAY  its builder is an instrument for the original IOMobileFramebufferLegacy
#                              lifecycle and compiles kits/sheng board code (touch, keystore, GPU power,
#                              Novatek, cpufreq). A text console does not need it: DarwinBoot fills
#                              boot_args.Video[6] from the UEFI GOP and XNU's pexpert video console draws
#                              through that. Turn it on again with a trimmed, board-neutral builder when a
#                              framebuffer service (not a text console) is wanted.
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n

# TODO(device): set the scratch Data volume UUID when the userdata image exists.
